                  <div class="mini-tile"><span>PMMA</span><b>82%</b></div>
                  <div class="mini-tile"><span>CBMMA</span><b>61%</b></div>
                  <div class="mini-tile"><span>PRF</span><b>45%</b></div>
                </div>
