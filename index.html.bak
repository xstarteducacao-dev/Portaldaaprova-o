<script>
  let current = 'mobile';
  let screenIndex = 0;
  const totalScreens = 4;

  function setDevice(mode){
    if(mode === current) return;
    current = mode;
    const phone = document.getElementById('device-phone');
    const laptop = document.getElementById('device-laptop');
    const btnMobile = document.getElementById('btn-mobile');
    const btnDesktop = document.getElementById('btn-desktop');

    if(mode === 'mobile'){
      phone.classList.remove('hidden-left','hidden-right'); phone.classList.add('shown');
      laptop.classList.remove('shown','hidden-left'); laptop.classList.add('hidden-right');
      btnMobile.classList.add('active'); btnDesktop.classList.remove('active');
    } else {
      laptop.classList.remove('hidden-left','hidden-right'); laptop.classList.add('shown');
      phone.classList.remove('shown','hidden-right'); phone.classList.add('hidden-left');
      btnDesktop.classList.add('active'); btnMobile.classList.remove('active');
    }
  }

  function renderDots(){
    const dots = document.getElementById('dots');
    dots.innerHTML = '';
    for(let i=0;i<totalScreens;i++){
      const d = document.createElement('i');
      if(i===screenIndex) d.classList.add('on');
      d.onclick = () => goToScreen(i);
      dots.appendChild(d);
    }
  }

  function goToScreen(i){
    screenIndex = i;
    document.querySelectorAll('#phone-screens .scr, #desktop-screens .scr').forEach(el=>{
      el.classList.toggle('on', Number(el.dataset.i) === i);
    });
    renderDots();
  }

  renderDots();
  setInterval(()=>{ goToScreen((screenIndex+1) % totalScreens); }, 4500);
</script>

</body>
</html>
