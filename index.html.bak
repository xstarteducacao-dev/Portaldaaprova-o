                </div>
                <div class="mini-navbar"><i class="on"></i><i></i><i></i><i></i></div>
              </div>
              <div class="scr" data-i="1">
                <div class="mini-phone-top"><div class="greet">Missão do Dia</div><div class="name">Constituição</div></div>
                <div class="mini-phone-body">
                  <div class="mini-row"><span>Progresso</span><b>74%</b></div>
                  <div class="mini-row"><span>Questões</span><b>60</b></div>
                  <div class="mini-row"><span>Recompensa</span><b>+320 XP</b></div>
                </div>
                <div class="mini-navbar"><i></i><i class="on"></i><i></i><i></i></div>
              </div>
              <div class="scr" data-i="2">
                <div class="mini-phone-top"><div class="greet">Force AI</div><div class="name">Assistente Tático</div></div>
                <div class="mini-phone-body">
                  <div class="mini-row"><span>"Explique art. 5º"</span><b>IA</b></div>
                  <div class="mini-row"><span>Resumo gerado</span><b>Pronto</b></div>
                </div>
                <div class="mini-navbar"><i></i><i></i><i class="on"></i><i></i></div>
              </div>
              <div class="scr" data-i="3">
                <div class="mini-phone-top"><div class="greet">Ranking</div><div class="name">Nacional</div></div>
                <div class="mini-phone-body">
                  <div class="mini-row"><span>1º Ana P.</span><b>22.140 XP</b></div>
                  <div class="mini-row"><span>2º Você</span><b>18.250 XP</b></div>
                  <div class="mini-row"><span>3º Lucas F.</span><b>17.900 XP</b></div>
                </div>
                <div class="mini-navbar"><i></i><i></i><i></i><i class="on"></i></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="device laptop hidden-right" id="device-laptop">
        <div class="laptop-screen">
          <div class="screen-frame">
            <div class="screen-crossfade" id="desktop-screens">
              <div class="scr on" data-i="0">
                <div class="mini-top"><div class="brand">FORCE ACADEMY</div><div class="dot"></div></div>
