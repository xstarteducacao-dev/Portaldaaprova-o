<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FORCE ACADEMY — Centro Operacional de Preparação</title>
<style>
  :root{
    --bg:#0C0C0C;
    --surface:#161615;
    --surface-2:#1D1C1A;
    --border:#2E2C28;
    --border-soft:#232220;
    --text:#EDEAE4;
    --text-dim:#A29B8E;
    --text-faint:#6B655B;
    --red:#B5231F;
    --red-2:#8A1917;
    --red-ink:#2A0605;
    --gold:#C7A25C;
    --font-display:"Arial Narrow","Helvetica Neue Condensed","Segoe UI",Arial,sans-serif;
    --font-body:-apple-system,"Segoe UI",Roboto,system-ui,sans-serif;
    --font-mono:ui-monospace,"SF Mono","Roboto Mono",Menlo,Consolas,monospace;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  body{
    background:var(--bg); color:var(--text); font-family:var(--font-body);
    -webkit-font-smoothing:antialiased; overflow-x:hidden; font-size:16px; line-height:1.55;
  }
  @media (prefers-reduced-motion: reduce){ *{ animation-duration:.001ms !important; transition-duration:.001ms !important; } }
  img,svg{ max-width:100%; display:block; }
  a{ color:inherit; text-decoration:none; }
  .container{ max-width:1180px; margin:0 auto; padding:0 28px; }
  .mono{ font-family:var(--font-mono); }
  ::selection{ background:var(--red); color:#fff; }

  /* grunge texture overlay, applied per-section via .grit */
  .grit{ position:relative; }
  .grit::before{
    content:''; position:absolute; inset:0; pointer-events:none; z-index:1; opacity:.5; mix-blend-mode:overlay;
    background:
      radial-gradient(ellipse at 15% 20%, rgba(255,255,255,.05), transparent 40%),
      radial-gradient(ellipse at 85% 75%, rgba(255,255,255,.04), transparent 45%),
      repeating-linear-gradient(115deg, rgba(255,255,255,.015) 0px, rgba(255,255,255,.015) 1px, transparent 1px, transparent 3px);
  }
  .grit-dark::before{
    background:
      radial-gradient(ellipse at 20% 30%, rgba(0,0,0,.35), transparent 45%),
      radial-gradient(ellipse at 80% 70%, rgba(0,0,0,.3), transparent 50%),
      repeating-linear-gradient(115deg, rgba(0,0,0,.04) 0px, rgba(0,0,0,.04) 1px, transparent 1px, transparent 3px);
    mix-blend-mode:multiply; opacity:.8;
  }

  .label{
    font-family:var(--font-mono); font-size:11px; letter-spacing:.14em;
    color:var(--red); text-transform:uppercase; display:inline-flex; align-items:center; gap:8px;
    margin-bottom:14px; font-weight:700;
  }
  .label::before{ content:''; width:16px; height:2px; background:var(--red); }

  h1,h2,h3,h4{ font-family:var(--font-display); font-weight:900; letter-spacing:-0.01em; text-wrap:balance; text-transform:uppercase; }
  .tnum{ font-variant-numeric:tabular-nums; }

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    padding:13px 24px; font-weight:800; font-size:12.5px; text-transform:uppercase; letter-spacing:.08em;
    cursor:pointer; border:1px solid transparent; transition:all .18s ease; font-family:var(--font-body);
  }
  .btn-primary{ background:var(--red); color:#fff; }
  .btn-primary:hover{ background:#cf2823; }
  .btn-ghost{ background:transparent; border-color:var(--border); color:var(--text); }
  .btn-ghost:hover{ border-color:var(--text-dim); }
  .btn-sm{ padding:8px 16px; font-size:11px; }

  /* NAV */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    background:rgba(12,12,12,.88); backdrop-filter:blur(8px); border-bottom:1px solid var(--border-soft);
  }
  .nav{ display:flex; align-items:center; justify-content:space-between; height:68px; }
  .logo{ display:flex; align-items:center; gap:11px; font-family:var(--font-display); font-weight:900; font-size:17px; letter-spacing:.03em; text-transform:uppercase; }
  .logo .mark{
    width:34px; height:34px; border:2px solid var(--red); border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-size:13px; font-weight:900; color:var(--red);
  }
  .nav-links{ display:flex; gap:26px; font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-dim); font-weight:700; }
  .nav-links a{ transition:color .15s; }
  .nav-links a:hover{ color:var(--text); }
  @media (max-width:900px){ .nav-links{ display:none; } }

  /* HERO */
  .hero{
    position:relative; padding:190px 0 90px; overflow:hidden;
    background:
      linear-gradient(180deg, rgba(12,12,12,.2), rgba(12,12,12,.95) 85%),
      radial-gradient(ellipse 900px 500px at 50% 30%, #2a2723 0%, #171614 55%, #0c0c0c 100%);
    border-bottom:1px solid var(--border-soft);
    text-align:center;
  }
  .hero-scan{
    position:absolute; inset:0; z-index:0; opacity:.6;
    background-image: linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
    background-size:64px 64px;
    mask-image:radial-gradient(ellipse at 50% 20%, black, transparent 70%);
  }
  .hero-inner{ position:relative; z-index:2; }
  .hero h1{
    font-size:clamp(64px,13vw,168px); line-height:.86; letter-spacing:-0.01em;
    background:
      linear-gradient(180deg, #f2ede2 0%, #cbbfa4 38%, #4a4136 62%, #17140f 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-shadow:0 2px 0 rgba(0,0,0,.4);
  }
  .hero .tagline{
    margin-top:18px; font-family:var(--font-display); font-weight:800; letter-spacing:.1em; font-size:15px;
    color:var(--red); text-transform:uppercase;
  }
  .hero .sub{ margin-top:22px; font-size:16px; color:var(--text-dim); max-width:480px; margin-left:auto; margin-right:auto; }
  .hero-cta{ margin-top:38px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }

  .divider{ border:none; border-top:1px solid var(--border-soft); margin:0; }

  /* NEWS TICKER — "O FORCE EM AÇÃO" */
  .ticker-section{ padding:70px 0 90px; border-bottom:1px solid var(--border-soft); }
  .ticker-head{ text-align:center; margin-bottom:44px; }
  .ticker-head h2{ font-size:clamp(22px,3vw,30px); }
  .ticker-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1px; background:var(--border); border:1px solid var(--border); }
  .ticker-item{ background:var(--surface); padding:26px 24px; }
  .ticker-item .date{ font-family:var(--font-mono); font-size:12px; color:var(--red); font-weight:700; letter-spacing:.05em; }
  .ticker-item p{ margin-top:12px; font-size:13.5px; color:var(--text-dim); line-height:1.6; }
  .ticker-item .more{ display:inline-block; margin-top:16px; }

  /* SECTION SHARED */
  section{ padding:96px 0; border-bottom:1px solid var(--border-soft); }
  .section-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:40px; margin-bottom:50px; flex-wrap:wrap; }
  .section-head h2{ font-size:clamp(24px,3.2vw,34px); max-width:520px; }
  .section-head p{ max-width:320px; color:var(--text-dim); font-size:14px; line-height:1.6; text-transform:none; font-family:var(--font-body); font-weight:400; }

  /* MISSION LIST */
  .mission-list{ border:1px solid var(--border); }
  .mission-row{
    display:grid; grid-template-columns:1.4fr .8fr .8fr .8fr 1.2fr; align-items:center; gap:16px;
    padding:18px 22px; border-bottom:1px solid var(--border-soft); font-size:13.5px;
  }
  .mission-row:last-child{ border-bottom:none; }
  .mission-row:hover{ background:var(--surface); }
  .mission-row.head{ font-family:var(--font-mono); font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-faint); background:var(--surface-2); }
  .mission-row .name{ font-weight:700; display:flex; flex-direction:column; gap:2px; text-transform:uppercase; font-family:var(--font-display); font-size:14px; }
  .mission-row .name small{ font-weight:400; color:var(--text-faint); font-size:11px; font-family:var(--font-mono); text-transform:none; }
  .mission-row .num{ font-family:var(--font-mono); color:var(--text-dim); }
  .bar{ height:4px; background:var(--border); overflow:hidden; }
  .bar i{ display:block; height:100%; background:var(--red); }
  @media (max-width:760px){ .mission-row{ grid-template-columns:1fr; gap:6px; } .mission-row.head{ display:none; } .mission-row .num::before{ content:attr(data-label) ": "; color:var(--text-faint); } }

  /* EXAM CARDS */
  .exam-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1px; background:var(--border); border:1px solid var(--border); }
  .exam-card{ background:var(--surface); padding:26px 24px; }
  .exam-card:hover{ background:var(--surface-2); }
  .exam-card .top{ display:flex; justify-content:space-between; align-items:baseline; }
  .exam-card h4{ font-size:17px; }
  .exam-card .pct{ font-family:var(--font-mono); font-size:15px; color:var(--red); font-weight:700; }
  .exam-card .bar{ margin-top:16px; }
  .exam-card .cta{ margin-top:16px; font-size:11px; color:var(--text-dim); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.05em; }
  .exam-card:hover .cta{ color:var(--red); }

  /* VIDEO / DEMO BLOCK */
  .demo-block{
    border:1px solid var(--border); background:var(--surface); aspect-ratio:16/7; position:relative;
    display:flex; align-items:center; justify-content:center; overflow:hidden;
  }
  .demo-block::before{
    content:''; position:absolute; inset:0;
    background:radial-gradient(ellipse at 50% 40%, #211f1c, #0c0c0c 75%);
  }
  .play-btn{
    position:relative; z-index:2; width:74px; height:74px; border-radius:50%; border:2px solid var(--red);
    display:flex; align-items:center; justify-content:center; cursor:pointer; transition:.2s;
  }
  .play-btn:hover{ background:var(--red); }
  .play-btn::after{ content:''; width:0; height:0; border-style:solid; border-width:11px 0 11px 18px; border-color:transparent transparent transparent var(--text); margin-left:5px; }
  .demo-caption{ position:absolute; bottom:20px; left:24px; z-index:2; font-family:var(--font-mono); font-size:11.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.06em; }

  /* GALLERY */
  .gallery{ display:grid; grid-template-columns:repeat(8,1fr); gap:2px; }
  .gallery-tile{
    aspect-ratio:1; background:var(--surface); border:1px solid var(--border-soft);
    display:flex; align-items:center; justify-content:center; font-size:18px; color:var(--text-faint);
    filter:grayscale(1); transition:.2s;
  }
  .gallery-tile:hover{ filter:grayscale(0); color:var(--red); background:var(--surface-2); }
  @media (max-width:760px){ .gallery{ grid-template-columns:repeat(4,1fr); } }

  /* RANK LADDER */
  .ladder{ display:flex; flex-direction:column; border:1px solid var(--border); }
  .rung{ display:grid; grid-template-columns:40px 1fr auto; align-items:center; gap:16px; padding:13px 20px; border-bottom:1px solid var(--border-soft); font-size:13px; }
  .rung:last-child{ border-bottom:none; }
  .rung .idx{ font-family:var(--font-mono); color:var(--text-faint); font-size:11px; }
  .rung .tick{ width:8px; height:8px; background:var(--border); justify-self:start; }
  .rung.current{ background:rgba(181,35,31,.1); }
  .rung.current .tick{ background:var(--red); }
  .rung.done .tick{ background:var(--gold); }
  .rung .name{ font-weight:800; text-transform:uppercase; font-family:var(--font-display); font-size:13.5px; }
  .rung.locked .name{ color:var(--text-faint); font-weight:400; text-transform:none; font-family:var(--font-body); }
  .rung .status{ font-family:var(--font-mono); font-size:10.5px; color:var(--text-faint); text-transform:uppercase; letter-spacing:.04em; }
  .rung.current .status{ color:var(--red); font-weight:700; }
  .ladder-scroll{ max-height:420px; overflow-y:auto; }

  /* AI PANEL */
  .ai-panel{ display:grid; grid-template-columns:1fr 1fr; border:1px solid var(--border); }
  .ai-copy{ padding:48px; display:flex; flex-direction:column; justify-content:center; }
  .ai-copy h3{ font-size:26px; }
  .ai-copy p{ margin-top:14px; color:var(--text-dim); line-height:1.7; font-size:15px; text-transform:none; font-family:var(--font-body); font-weight:400; }
  .ai-copy ul{ margin-top:20px; list-style:none; display:flex; flex-direction:column; gap:9px; }
  .ai-copy li{ font-size:13px; color:var(--text-dim); display:flex; gap:10px; font-family:var(--font-mono); }
  .ai-copy li::before{ content:'—'; color:var(--red); }
  .ai-chat{ background:var(--surface); border-left:1px solid var(--border); padding:28px; display:flex; flex-direction:column; gap:12px; justify-content:center; }
  .msg{ max-width:88%; padding:12px 15px; font-size:13px; line-height:1.55; }
  .msg.user{ align-self:flex-end; background:var(--red); color:#fff; font-weight:600; }
  .msg.ai{ align-self:flex-start; background:var(--surface-2); border:1px solid var(--border-soft); color:var(--text-dim); font-family:var(--font-mono); font-size:12.5px; }
  @media (max-width:820px){ .ai-panel{ grid-template-columns:1fr; } .ai-chat{ border-left:none; border-top:1px solid var(--border); } }

  /* HALL DA HONRA */
  .honor-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1px; background:var(--border); border:1px solid var(--border); }
  .honor-card{ background:var(--surface); padding:24px; display:flex; flex-direction:column; gap:14px; }
  .honor-avatar{ width:40px; height:40px; border-radius:50%; background:var(--surface-2); border:1px solid var(--gold); display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:700; font-size:13px; color:var(--gold); }
  .honor-card .badge{ font-size:11px; color:var(--gold); text-transform:uppercase; letter-spacing:.06em; font-weight:700; font-family:var(--font-mono); }
  .honor-card h4{ font-size:16px; }
  .honor-card p{ font-size:13px; color:var(--text-dim); line-height:1.55; text-transform:none; font-family:var(--font-body); font-weight:400; }

  /* RED CTA BANNER */
  .cta-banner{
    position:relative; overflow:hidden; padding:76px 0; border-bottom:1px solid var(--border-soft);
    background:#0c0c0c;
  }
  .cta-banner::before{
    content:''; position:absolute; inset:0;
    background:linear-gradient(100deg, #0c0c0c 0%, #0c0c0c 42%, var(--red-2) 42%, var(--red) 100%);
  }
  .cta-inner{ position:relative; z-index:2; display:flex; justify-content:space-between; align-items:center; gap:40px; flex-wrap:wrap; }
  .cta-inner h2{ font-size:clamp(24px,3.6vw,38px); max-width:420px; color:#fff; }
  .cta-links{ display:flex; flex-direction:column; gap:12px; font-family:var(--font-mono); font-size:13px; text-transform:uppercase; letter-spacing:.06em; }
  .cta-links a{ opacity:.9; transition:.2s; }
  .cta-links a:hover{ opacity:1; text-decoration:underline; }

  /* DEVICE SHOWCASE */
  .device-switch{ display:flex; justify-content:center; margin-bottom:56px; }
  .switch-track{ display:inline-flex; gap:2px; padding:3px; background:var(--surface); border:1px solid var(--border); }
  .switch-btn{
    position:relative; padding:10px 24px; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:.06em;
    color:var(--text-dim); cursor:pointer; border:none; font-family:var(--font-body); background:transparent;
    transition:color .25s ease; z-index:1;
  }
  .switch-btn.active{ color:#fff; }
  .switch-btn .glow{ position:absolute; inset:0; z-index:-1; opacity:0; transition:opacity .3s ease; background:var(--red); }
  .switch-btn.active .glow{ opacity:1; }

  .stage{ position:relative; display:flex; align-items:center; justify-content:center; min-height:600px; perspective:1400px; }
  .device{ position:absolute; transition:transform .6s cubic-bezier(.22,1,.36,1), opacity .5s ease, filter .5s ease; }
  .device.hidden-left{ transform:translateX(-110%) rotateY(14deg) scale(.9); opacity:0; filter:blur(4px); pointer-events:none; }
  .device.hidden-right{ transform:translateX(110%) rotateY(-14deg) scale(.9); opacity:0; filter:blur(4px); pointer-events:none; }
  .device.shown{ transform:translateX(0) rotateY(0) scale(1); opacity:1; filter:blur(0); }

  .laptop{ width:min(820px,86vw); }
  .laptop-screen{ border:9px solid var(--surface-2); border-bottom:none; border-radius:8px 8px 0 0; background:var(--bg); box-shadow:0 35px 80px -25px rgba(0,0,0,.6); }
  .laptop-base{ height:14px; background:var(--surface-2); border-radius:0 0 6px 6px; position:relative; }
  .laptop-base::after{ content:''; position:absolute; left:50%; top:0; transform:translateX(-50%); width:80px; height:4px; background:var(--border); border-radius:0 0 4px 4px; }

  .phone{ width:min(280px,70vw); }
  .phone-body{ border:9px solid var(--surface-2); border-radius:32px; background:var(--bg); padding:6px; box-shadow:0 35px 80px -25px rgba(0,0,0,.6); position:relative; }
  .phone-notch{ position:absolute; top:12px; left:50%; transform:translateX(-50%); width:70px; height:18px; background:var(--surface-2); border-radius:10px; z-index:2; }

  .screen-frame{ background:var(--bg); border-radius:20px; overflow:hidden; aspect-ratio:9/19.5; position:relative; }
  .laptop .screen-frame{ border-radius:2px; aspect-ratio:16/10; }
  .screen-crossfade{ position:relative; width:100%; height:100%; }
  .scr{ position:absolute; inset:0; opacity:0; transition:opacity .45s ease; display:flex; flex-direction:column; }
  .scr.on{ opacity:1; }

  .mini-top{ display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--border-soft); }
  .mini-top .brand{ font-size:11px; font-weight:900; letter-spacing:.05em; font-family:var(--font-display); text-transform:uppercase; }
  .mini-top .dot{ width:6px; height:6px; border-radius:50%; background:var(--red); }
  .mini-body{ flex:1; padding:18px; display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; align-content:start; }
  .mini-tile{ border:1px solid var(--border-soft); padding:11px; background:var(--surface); }
  .mini-tile span{ font-size:9px; color:var(--text-faint); text-transform:uppercase; font-family:var(--font-mono); }
  .mini-tile b{ display:block; font-size:14px; margin-top:5px; font-family:var(--font-mono); }
  .mini-wide{ grid-column:1/-1; height:60px; border:1px solid var(--border-soft); background:linear-gradient(90deg, rgba(181,35,31,.15), transparent); }

  .mini-phone-top{ padding:20px 16px 8px; }
  .mini-phone-top .greet{ font-size:10px; color:var(--text-faint); font-family:var(--font-mono); text-transform:uppercase; }
  .mini-phone-top .name{ font-size:15px; font-weight:900; margin-top:4px; font-family:var(--font-display); text-transform:uppercase; }
  .mini-phone-body{ flex:1; padding:0 16px; display:flex; flex-direction:column; gap:8px; }
  .mini-row{ border:1px solid var(--border-soft); padding:11px; display:flex; justify-content:space-between; align-items:center; background:var(--surface); }
  .mini-row span{ font-size:11px; color:var(--text-dim); }
  .mini-row b{ font-size:11px; color:var(--red); font-family:var(--font-mono); }
  .mini-navbar{ margin-top:auto; display:flex; justify-content:space-around; padding:12px 0; border-top:1px solid var(--border-soft); }
  .mini-navbar i{ width:14px; height:3px; background:var(--border); }
  .mini-navbar i.on{ background:var(--red); }

  .screen-dots{ display:flex; gap:7px; justify-content:center; margin-top:26px; }
  .screen-dots i{ width:6px; height:6px; background:var(--border); cursor:pointer; transition:.2s; display:block; }
  .screen-dots i.on{ background:var(--red); width:20px; }

  .showcase-caption{ text-align:center; margin-top:34px; font-size:12px; color:var(--text-faint); font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.05em; }
  .showcase-caption b{ color:var(--red); }

  footer{ padding:0; }
  .footer-inner{ padding:50px 0 30px; text-align:center; }
  .footer-social{ display:flex; justify-content:center; gap:16px; margin-bottom:20px; }
  .footer-social span{ width:34px; height:34px; border:1px solid var(--border); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:13px; color:var(--text-dim); }
  .footer-links{ display:flex; justify-content:center; gap:24px; font-family:var(--font-mono); font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-faint); margin-bottom:20px; flex-wrap:wrap; }
  .footer-bottom{ font-size:11px; color:var(--text-faint); font-family:var(--font-mono); border-top:1px solid var(--border-soft); padding:18px 0; text-align:center; }
</style>
</head>
<body>

<header>
  <div class="container nav">
    <div class="logo"><div class="mark">F</div> FORCE ACADEMY</div>
    <nav class="nav-links">
      <a href="#operacoes">Centro de Operações</a>
      <a href="#missoes">Missões</a>
      <a href="#ai">Force AI</a>
      <a href="#showcase">Plataforma</a>
      <a href="#honra">Hall da Honra</a>
    </nav>
    <a href="#showcase" class="btn btn-primary btn-sm">Iniciar Operação</a>
  </div>
</header>

<section class="hero grit">
  <div class="hero-scan"></div>
  <div class="container hero-inner">
    <div class="label" style="justify-content:center;">Centro Operacional de Preparação</div>
    <h1>FORCE<br/>ACADEMY</h1>
